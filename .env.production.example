# Project B 生产模板示例（企业内网试点）
# 仅用于说明必填项，不可直接用于生产部署。
# 必须在部署环境中注入真实安全变量，不要提交真实凭据文件。

# 应用环境
APP_ENV=production
DEBUG=false
CORS_ENABLED=true
# 生产环境必须配置明确来源，不允许使用 *
CORS_ALLOW_ORIGINS=https://your-console.example.com
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type
SECURITY_HEADERS_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_BURST=60
RATE_LIMIT_EXEMPT_PATHS=/health
REQUEST_SIZE_LIMIT_ENABLED=true
REQUEST_SIZE_LIMIT_BYTES=1048576
ABUSE_GUARD_ENABLED=true
STRUCTURED_LOGGING_ENABLED=true
LOG_LEVEL=INFO
LOG_INCLUDE_CLIENT_IP=true
LOG_INCLUDE_USER_AGENT=true
LOG_REDACTION_ENABLED=true
AUDIT_RETENTION_ENABLED=true
AUDIT_RETENTION_DAYS=90
AUDIT_EXPORT_ENABLED=true
AUDIT_EXPORT_MAX_ROWS=1000
AUDIT_EXPORT_FORMAT=jsonl
AUDIT_EXPORT_REDACTION_ENABLED=true
OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET_ENV=OIDC_CLIENT_SECRET
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid,email,profile
OIDC_ROLE_CLAIM=roles
OIDC_DEFAULT_ROLE=viewer
OIDC_ALLOWED_ROLES=admin,operator,viewer,auditor
OIDC_REQUIRE_HTTPS=true

# 存储配置（生产模板默认 PostgreSQL）
STORAGE_BACKEND=postgres
# 必填：替换为真实安全连接串（示例仅占位）
DATABASE_URL=postgresql+psycopg://agent:<replace-with-strong-password>@postgres:5432/project_b

# Redis 配置
REDIS_ENABLED=true
# 必填：替换为真实安全连接串（示例仅占位）
REDIS_URL=redis://:<replace-with-strong-password>@redis:6379/0

# 鉴权与权限（生产模板要求开启）
AUTH_ENABLED=true
RBAC_ENABLED=true
# 必填：长度不少于 32 字符，不能使用占位值
JWT_SECRET=<replace-with-at-least-32-char-secret>

# MCP 与真实 LLM 默认仍保持关闭（离线路径）
MCP_MODE=fake
MCP_SERVER_COMMAND=
MCP_SERVER_ARGS=
MCP_SERVER_TIMEOUT_SECONDS=10
MCP_SERVER_ENV_ALLOWLIST=
MCP_SERVER_COMMAND_ALLOWLIST=
MCP_TOOL_ALLOWLIST=
REAL_LLM_ACCEPTANCE_ENABLED=false
REAL_LLM_PREFLIGHT_ENABLED=false
REAL_LLM_SMOKE_ENABLED=false
REAL_LLM_PREFLIGHT_NETWORK_CHECK=false
REAL_LLM_PROVIDER=litellm

# 真实 LLM 可选验收配置（默认留空，不进入默认路径）
REAL_LLM_MODEL=
REAL_LLM_BASE_URL=
REAL_LLM_API_KEY_ENV=OPENAI_API_KEY
REAL_LLM_PREFLIGHT_TIMEOUT_SECONDS=10

# v4.4 real integration staging smoke switches (disabled by default)
REAL_INTEGRATION_STAGING_SMOKE_ENABLED=false
REAL_LLM_STAGING_SMOKE_EXECUTE=false
POSTGRES_STAGING_SMOKE_EXECUTE=false
REDIS_STAGING_SMOKE_EXECUTE=false
MCP_STAGING_SMOKE_EXECUTE=false

# Business system read-only integration smoke (disabled by default)
BUSINESS_INTEGRATION_ENABLED=false
BUSINESS_INTEGRATION_READ_ONLY=true
BUSINESS_INTEGRATION_WRITE_ENABLED=false
BUSINESS_INTEGRATION_APPROVAL_REQUIRED=true
BUSINESS_INTEGRATION_AUDIT_REQUIRED=true
BUSINESS_SYSTEM_NAME=
BUSINESS_SYSTEM_BASE_URL_ENV=BUSINESS_SYSTEM_BASE_URL
BUSINESS_SYSTEM_TOKEN_ENV=BUSINESS_SYSTEM_TOKEN
BUSINESS_SYSTEM_BASE_URL=
BUSINESS_SYSTEM_TOKEN=
BUSINESS_SYSTEM_TOOL_ALLOWLIST=business_read_probe
BUSINESS_SYSTEM_WRITE_TOOL_ALLOWLIST=
BUSINESS_SYSTEM_TIMEOUT_SECONDS=5
BUSINESS_SYSTEM_READ_PROBE_PATH=/health
BUSINESS_SYSTEM_AUTH_HEADER_NAME=Authorization
BUSINESS_SYSTEM_AUTH_SCHEME=Bearer
