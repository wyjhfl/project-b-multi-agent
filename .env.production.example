# Project B 生产模板示例（企业内网试点）
# 复制为 .env.production 后再填写真实值，不要提交真实文件。

# 应用环境
APP_ENV=production
DEBUG=false

# 存储配置（生产模板默认 PostgreSQL）
STORAGE_BACKEND=postgres
DATABASE_URL=postgresql+psycopg://agent:replace-me@postgres:5432/project_b

# Redis 配置
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0

# 鉴权与权限（生产模板要求开启）
AUTH_ENABLED=true
RBAC_ENABLED=true
JWT_SECRET=change-me-strong-secret

# MCP 与真实 LLM 默认仍保持关闭/离线路径
MCP_MODE=fake
REAL_LLM_ACCEPTANCE_ENABLED=false

# 真实 LLM 可选验收配置（默认留空，不进入默认路径）
REAL_LLM_MODEL=
REAL_LLM_API_KEY_ENV=OPENAI_API_KEY
