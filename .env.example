# Project B: Harness-native 运营中台 Agent
# 复制此文件为 .env 并填入实际值

# 应用配置
APP_NAME=project-b-multi-agent
APP_ENV=development
DEBUG=true
CORS_ENABLED=true
CORS_ALLOW_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type
SECURITY_HEADERS_ENABLED=true
RATE_LIMIT_ENABLED=false
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_BURST=60
RATE_LIMIT_EXEMPT_PATHS=/health
REQUEST_SIZE_LIMIT_ENABLED=true
REQUEST_SIZE_LIMIT_BYTES=1048576
ABUSE_GUARD_ENABLED=true
STRUCTURED_LOGGING_ENABLED=true
LOG_LEVEL=INFO
LOG_INCLUDE_CLIENT_IP=true
LOG_INCLUDE_USER_AGENT=true
LOG_REDACTION_ENABLED=true
AUDIT_RETENTION_ENABLED=true
AUDIT_RETENTION_DAYS=90
AUDIT_EXPORT_ENABLED=true
AUDIT_EXPORT_MAX_ROWS=1000
AUDIT_EXPORT_FORMAT=jsonl
AUDIT_EXPORT_REDACTION_ENABLED=true
OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET_ENV=OIDC_CLIENT_SECRET
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid,email,profile
OIDC_ROLE_CLAIM=roles
OIDC_DEFAULT_ROLE=viewer
OIDC_ALLOWED_ROLES=admin,operator,viewer,auditor
OIDC_REQUIRE_HTTPS=true

# 运营数据库路径
OPS_DB_PATH=data/db/ops_demo.sqlite

# NL2SQL 生成器配置
# mock: 使用 MockNL2SQLGenerator（默认，无需 API Key）
# llm: 使用 LLMNL2SQLGenerator（需要 LLM API Key）
NL2SQL_GENERATOR=mock

# LLM Provider 配置
# fake: FakeLLMProvider（测试用，不调用真实 API）
# litellm: LiteLLMProvider（调用真实 LLM，需要 API Key，需安装可选依赖 litellm）
# openai_compatible: OpenAICompatibleProvider（纯 httpx 直连 OpenAI 兼容端点，无需 litellm）
LLM_PROVIDER=fake
LLM_MODEL=
LLM_API_KEY=
LLM_API_KEY_ENV=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=0
LLM_RETRY_BACKOFF_SECONDS=0.5
LLM_TEMPERATURE=0.0
LLM_STREAM_CHUNK_CHARS=24

# LLM 成本预估（单价默认 0，预估成本为 0，行为与旧版一致）
LLM_COST_ESTIMATION_ENABLED=true
LLM_COST_PER_1K_PROMPT_TOKENS_USD=0.0
LLM_COST_PER_1K_COMPLETION_TOKENS_USD=0.0
LLM_ESTIMATED_COMPLETION_TOKENS=256

# Planner 配置
# keyword: KeywordPlanner 规则路由（默认）
# llm: LLMToolPlanner function calling 选工具，失败自动降级 keyword
PLANNER_MODE=keyword
COORDINATOR_LLM_ENABLED=false

# NL2SQL SSE 流式端点（离线 fake 模式可演示）
NL2SQL_STREAM_ENABLED=true

# 高风险 HITL 演示工具 simulate_refund_order（纯内存仿真）
DEMO_HIGH_RISK_TOOL_ENABLED=true

# LangGraph GraphRuntimeAdapter checkpoint 路径（默认关闭）
GRAPH_RUNTIME_ENABLED=false

# Judge Provider 配置
# fake: FakeJudge（默认，离线可跑）
# litellm: LLMJudgeProvider（可选，需要配置 LLM_API_KEY）
JUDGE_PROVIDER=fake
JUDGE_FALLBACK_TO_FAKE=true
JUDGE_MODEL=
JUDGE_BASE_URL=
JUDGE_TIMEOUT_SECONDS=15
JUDGE_MAX_RETRIES=0
JUDGE_RETRY_BACKOFF_SECONDS=0.5

# LLM 预算与缓存配置（默认关闭，不影响离线路径）
LLM_BUDGET_ENABLED=false
LLM_BUDGET_SOFT_USD=0
LLM_BUDGET_HARD_USD=0
LLM_BUDGET_SCOPE=daily
LLM_CACHE_ENABLED=false
LLM_CACHE_TTL_SECONDS=3600

# 真实 LLM 可选验收开关（默认关闭，不影响离线路径）
REAL_LLM_ACCEPTANCE_ENABLED=false
REAL_LLM_PREFLIGHT_ENABLED=false
REAL_LLM_PROVIDER=litellm
REAL_LLM_MODEL=
REAL_LLM_BASE_URL=
REAL_LLM_API_KEY_ENV=OPENAI_API_KEY
REAL_LLM_PREFLIGHT_TIMEOUT_SECONDS=10
REAL_LLM_PREFLIGHT_NETWORK_CHECK=false
REAL_LLM_SMOKE_ENABLED=false

# v4.4 real integration staging smoke switches (disabled by default)
REAL_INTEGRATION_STAGING_SMOKE_ENABLED=false
REAL_LLM_STAGING_SMOKE_EXECUTE=false
POSTGRES_STAGING_SMOKE_EXECUTE=false
REDIS_STAGING_SMOKE_EXECUTE=false
MCP_STAGING_SMOKE_EXECUTE=false

# MCP Server 配置
# fake: 使用 FakeMCPClient（默认，无需外部服务）
# real: 使用 StdioMCPClient（需要配置 command）
MCP_MODE=fake
MCP_SERVER_NAME=fake_ops_mcp
MCP_SERVER_COMMAND=
MCP_SERVER_ARGS=
MCP_SERVER_TIMEOUT_SECONDS=10
MCP_SERVER_ENV_ALLOWLIST=
MCP_SERVER_COMMAND_ALLOWLIST=
MCP_TOOL_ALLOWLIST=

# Business system read-only integration smoke (disabled by default)
BUSINESS_INTEGRATION_ENABLED=false
BUSINESS_INTEGRATION_READ_ONLY=true
BUSINESS_INTEGRATION_WRITE_ENABLED=false
BUSINESS_INTEGRATION_APPROVAL_REQUIRED=true
BUSINESS_INTEGRATION_AUDIT_REQUIRED=true
BUSINESS_SYSTEM_NAME=
BUSINESS_SYSTEM_BASE_URL_ENV=BUSINESS_SYSTEM_BASE_URL
BUSINESS_SYSTEM_TOKEN_ENV=BUSINESS_SYSTEM_TOKEN
BUSINESS_SYSTEM_BASE_URL=
BUSINESS_SYSTEM_TOKEN=
BUSINESS_SYSTEM_TOOL_ALLOWLIST=business_read_probe
BUSINESS_SYSTEM_WRITE_TOOL_ALLOWLIST=
BUSINESS_SYSTEM_TIMEOUT_SECONDS=5
BUSINESS_SYSTEM_READ_PROBE_PATH=/health
BUSINESS_SYSTEM_AUTH_HEADER_NAME=Authorization
BUSINESS_SYSTEM_AUTH_SCHEME=Bearer
BUSINESS_SYSTEM_BUSINESS_OWNER=<owner-or-staff-id>
BUSINESS_SYSTEM_SECURITY_REVIEWER=<owner-or-staff-id>
BUSINESS_SYSTEM_OPERATIONS_OWNER=<owner-or-staff-id>
BUSINESS_SYSTEM_DATA_OWNER=<owner-or-staff-id>

# Runtime Metrics 数据库路径
METRICS_DB_PATH=data/db/runtime_metrics.sqlite

# PostgreSQL 配置（企业试点）
# 留空则使用 SQLite
DATABASE_URL=
STORAGE_BACKEND=sqlite

# Redis 配置（企业试点）
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# JWT / Auth 配置（企业试点）
JWT_SECRET=dev-only-change-me-please-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_ENABLED=false

# RBAC 配置（企业试点）
RBAC_ENABLED=false
